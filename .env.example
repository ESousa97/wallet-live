# Copy this file to `.env` for local development.
# As três primeiras são OBRIGATÓRIAS — o serviço não sobe sem elas (ver config.rs).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
ADMIN_SECRET_KEY=change-me
JWT_SECRET=change-me-to-a-long-random-secret

# Opcionais (com padrão sensato):
# Marque os cookies como `Secure` (só trafegam em HTTPS). Use `true` em produção.
COOKIE_SECURE=false
# Endereço/porta de escuta. Padrão: 0.0.0.0:3000
# BIND_ADDR=0.0.0.0:3000
# Validade do token de ACESSO, em minutos. Padrão: 10
# SESSION_TTL_MINUTES=10
# Validade do REFRESH token (sessão no servidor), em dias. Padrão: 14
# REFRESH_TTL_DAYS=14
# Intervalo do job de cotações, em minutos (0 desliga). Padrão: 10
# QUOTES_SYNC_MINUTES=10
# Formato de log: json (agregadores) ou texto legível. Padrão: texto
# LOG_FORMAT=json
# Nível de log. Padrão: info. Ex.: wallet=debug,info
# RUST_LOG=info
# Endpoint OTLP (HTTP) para exportar traces e métricas. Sem isto, nada é
# exportado — o serviço roda exatamente igual, sem tentar conectar em nada.
# `docker compose --profile observability up otel-collector` sobe um coletor
# local que só imprime o que recebe, pra conferir a exportação.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Nome do serviço como aparece no backend de observabilidade. Padrão: wallet
# OTEL_SERVICE_NAME=wallet
