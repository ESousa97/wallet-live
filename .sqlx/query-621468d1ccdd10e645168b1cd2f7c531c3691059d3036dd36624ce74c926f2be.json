{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                t.id,\n                t.kind,\n                a.name AS \"asset_name?\",\n                t.quantity,\n                t.unit_value,\n                t.cash_delta,\n                t.created_at\n            FROM transactions t\n            LEFT JOIN assets a ON a.id = t.asset_id\n            WHERE t.user_id = $1\n            ORDER BY t.created_at DESC, t.id DESC\n            LIMIT $2 OFFSET $3\n            ",
